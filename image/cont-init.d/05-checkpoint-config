#!/bin/sh
# Desliga o embrulho que o cron coloca em volta da resposta entregue.
#
# Sem isto, todo aviso proativo chega ao dono assim:
#
#   Cronjob Response: checkpoint-nudge
#   (job_id: b51718f5d934)
#   -------------
#   <a mensagem>
#   To stop or manage this job, send me a new message ...
#
# Numa ferramenta interna passa; num produto que estranhos instalam, é o agente
# vazando a própria plumbing na conversa — e o aviso proativo é metade deste
# produto, então isso apareceria toda vez.
#
# O próprio `cron/scheduler.py` documenta a chave: "Wrapping is on by default;
# set cron.wrap_response: false in config.yaml for clean output."
#
# Roda a cada boot, e não só na primeira instalação, porque a home é um volume
# que sobrevive a `docker compose down` — mas o config.yaml pode ser recriado
# pelo runtime, e um agente que volta a embrulhar depois de uma atualização é
# uma regressão silenciosa.
set -eu

CONFIG=/var/lib/hermes/config.yaml

[ -f "$CONFIG" ] || exit 0

# Insere a chave dentro da seção `cron:` que a imagem base já escreve. Se um dia
# ela deixar de existir, cria a seção no fim — nunca falha o boot por isso.
if ! grep -q '^[[:space:]]*wrap_response:' "$CONFIG"; then
  if grep -q '^cron:' "$CONFIG"; then
    sed -i 's/^cron:$/cron:\n  wrap_response: false/' "$CONFIG"
  else
    printf '\ncron:\n  wrap_response: false\n' >> "$CONFIG"
  fi
  echo "[checkpoint] cron.wrap_response=false — o aviso chega sem envelope"
fi

# ── O aviso de gateway reiniciando ───────────────────────────────────────────
#
# `docker compose up --build` derruba o gateway, e a plataforma manda ao dono um
# "Gateway shutting down — your current task will be interrupted". Em 14/09 duas
# correções de texto separadas por nove minutos viraram dois toques no celular
# dele às 22h30, sem contexto nenhum: quem recebe acha que quebrou.
#
# `gateway/config.py` declara `gateway_restart_notification: bool = True`, e é
# chave de plataforma — mora dentro de `platforms.<plataforma>`, não na raiz.
#
# Isto foi dado como corrigido em 15/09 e nunca tinha sido escrito: não existia
# nem no repositório nem no config vivo. Conferido em 16/09.
#
# A regra de juntar mudanças num rebuild só continua valendo: desligado, o custo
# deixa de ser um toque no celular e passa a ser o tique de cron que um restart
# mal cronometrado pode perder.
if ! grep -q '^[[:space:]]*gateway_restart_notification:' "$CONFIG"; then
  if grep -q '^  plow_chat:$' "$CONFIG"; then
    sed -i 's/^  plow_chat:$/  plow_chat:\n    gateway_restart_notification: false/' "$CONFIG"
    echo "[checkpoint] gateway_restart_notification=false — rebuild não toca o celular do dono"
  fi
fi

# ── O limite de truncagem do arquivo de contexto ─────────────────────────────
#
# O runtime corta o SOUL.md quando ele passa de um limite de CARACTERES, e o
# corte nao e no fim: `agent/prompt_builder.py` guarda 70% da cabeca e 20% da
# cauda e JOGA FORA O MEIO. Em 18/09 a persona chegou a 20240 caracteres contra
# um limite de 20000, e os 2240 descartados eram justamente as duas ressalvas
# mais caras deste projeto — a que proibe repetir uma recusa errada e a que diz
# que a lista de demandas e do agente. Ou seja: a persona cresceu e o runtime
# apagou em silencio a parte que impede o agente de recusar trabalho.
#
# Cortar texto para caber e escolher qual ressalva morre, que e o proprio
# defeito. Entao o limite e fixado.
#
# Chave de RAIZ, ao contrario de `cron.wrap_response` e de
# `platforms.plow_chat.*` — por isso a ancora `^context_file_max_chars:` na
# coluna 0. `_get_context_file_max_chars` prefere o valor explicito ao limite
# dinamico, que so vale quando a janela do modelo e conhecida.
#
# Custo: mais token no prefixo cacheado de cada turno. E a persona inteira.
if ! grep -q '^context_file_max_chars:' "$CONFIG"; then
  printf '\ncontext_file_max_chars: 40000\n' >> "$CONFIG"
  echo "[checkpoint] context_file_max_chars=40000 — a persona chega inteira"
fi

# ── A trava da skill `contribute` ────────────────────────────────────────────
#
# Quais repositórios o agente pode escrever. Vem do `.env` de quem instalou,
# porque cada instalação tem os seus — mas o script NUNCA lê essa lista do
# ambiente, e a diferença é a segurança inteira: um turno do agente consegue
# chamar um script com o ambiente que ele quiser (`CONTRIB_REPOS=qualquer-coisa
# python3 ...`), e aí a lista deixaria de ser trava e viraria sugestão.
#
# Então o boot, que é root, copia o valor para /opt — que o agente lê e não
# escreve. Mudar a lista passa a exigir editar o `.env` e reiniciar, que é uma
# ação do dono na máquina dele, não um turno de conversa.
#
# Arquivo sempre criado, mesmo vazio: ausente e vazio querem dizer a mesma coisa
# ("nenhum repositório liberado"), e um só caminho de leitura tem um só jeito de
# falhar.
mkdir -p /opt/checkpoint
LIBERADOS=/run/s6/container_environment/CONTRIB_REPOS
if [ -f "$LIBERADOS" ]; then
  tr ',' '\n' < "$LIBERADOS" | sed 's/[[:space:]]//g' | sed '/^$/d' > /opt/checkpoint/repos-liberados
else
  : > /opt/checkpoint/repos-liberados
fi
chmod 0644 /opt/checkpoint/repos-liberados
QUANTOS=$(wc -l < /opt/checkpoint/repos-liberados | tr -d ' ')
echo "[checkpoint] contribute: $QUANTOS repositório(s) liberado(s) para Pull Request"

# A área onde a skill clona. Volume novo nasce root:root, e o agente não
# escreveria nele — a falha apareceria só na primeira vez que alguém pedisse
# uma melhoria, que é tarde.
if [ -d /var/lib/checkpoint-work ]; then
  chown hermes:hermes /var/lib/checkpoint-work
  chmod 0750 /var/lib/checkpoint-work
fi
