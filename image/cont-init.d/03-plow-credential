#!/bin/sh
# Promove a credencial montada para o caminho que o runtime lê.
#
# O compose monta `./plow-credentials` em `/var/lib/plow/credentials.host:ro`, e
# não direto no caminho final, por um motivo que continua válido: um bind
# carrega o dono e o modo da MÁQUINA DE QUEM INSTALA, e um arquivo de credencial
# com a permissão que o Windows ou o Mac dele resolveu dar não é o que deve
# valer dentro do container. Root copia e fixa o modo aqui.
#
# Quem fazia essa promoção era a imagem base. **A base de 18/09 não faz mais** —
# `credentials.host` não aparece em lugar nenhum dela, conferido com grep no
# sistema de arquivos inteiro. O efeito é o pior possível: o container sobe,
# fica `Up`, e sessenta segundos depois o `plow-init` escreve
# "no credential at /var/lib/plow/credentials -- parking; no gateway will start".
# O agente não responde e nada no chat diz por quê.
#
# Fica aqui, e não depende mais da base: se uma versão futura voltar a promover,
# este script encontra o arquivo já no lugar e não faz nada.
set -eu

ORIGEM=/var/lib/plow/credentials.host
DESTINO=/var/lib/plow/credentials

[ -f "$ORIGEM" ] || exit 0
[ -f "$DESTINO" ] && exit 0

mkdir -p /var/lib/plow
# Escrito ao lado e renomeado por cima: uma cópia interrompida no meio deixaria
# um arquivo truncado, e o `plow-init` trataria isso como credencial inválida —
# que é um erro mais difícil de ler do que credencial ausente.
rm -f "$DESTINO.tmp"
cat "$ORIGEM" > "$DESTINO.tmp"
# root:root 0600, e o modo NÃO é escolha nossa: a base de 18/09 confere e
# recusa qualquer outro — "expected root:root at 600 or 400 -- parking". Eu
# tinha posto root:hermes 0640 achando que o grupo ajudaria o agente, e o boot
# parkeou de novo com essa frase. Ela é boa: diz o que esperava.
chown root:root "$DESTINO.tmp"
chmod 0600 "$DESTINO.tmp"
mv -f "$DESTINO.tmp" "$DESTINO"

echo "[checkpoint] credencial promovida para $DESTINO"
